# ─── Alcovia Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ── n8n Webhook ───────────────────────────────────────────────────────────────
# The webhook URL from your n8n workflow's "Webhook - Session Complete" node.
#
# n8n Cloud:       https://<your-subdomain>.app.n8n.cloud/webhook/alcovia-session-complete
# Self-hosted:     http://localhost:5678/webhook/alcovia-session-complete
#
# Leave blank to use the local mock sink at POST /mock-n8n-sink (for dev/demo)
N8N_WEBHOOK_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
